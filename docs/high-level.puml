@startuml

actor Client

package "AISafe" {
    
    [API Gateway]
    
    node "Aircraft Component" {
        [Aircraft Service]
        database "Aircraft DB"
    }
    
    node "Maintenance Component" {
            [Maintenance Service]
        database "Maintenance DB"
    }
    
    node "Airports & Routes Component" {
        [Airports Service]
        database "Airports DB"
    }
    
    node "Flight Operations Component" {
        [Flights Service]
        database "Flights DB"
    }
}

Client --> [API Gateway] : HTTP/REST
[API Gateway] --> [Aircraft Service]
[API Gateway] --> [Maintenance Service]
[API Gateway] --> [Airports Service]
[API Gateway] --> [Flights Service]

[Aircraft Service] -down-> "Aircraft DB"
[Maintenance Service] -down-> "Maintenance DB"
[Airports Service] -down-> "Airports DB"
[Flights Service] -down-> "Flights DB"

[Maintenance Service] .up.> [Aircraft Service] : HTTP (Status Updates)
[Flights Service] .up.> [Aircraft Service] : HTTP (Availability)
[Flights Service] .up.> [Airports Service] : HTTP (Route Validation)

@enduml
