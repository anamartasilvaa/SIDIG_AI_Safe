@startuml c4-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()

title AISafe - C4 Level 2 (Containers), docker-compose.secure.yml: no single point of failure in the application tier

Person(user, "AISafe User", "Admin, Backoffice, ATCC, Maintenance Technician/Supervisor")

System_Boundary(aisafe, "AISafe Flight Management System") {
    Container(gw, "API Gateway (x2)", "NGINX, HTTPS :8443 and :8444", "Two identical instances. Routing by service, round-robin and failover between replicas, rate limiting, blocking of /internal, /actuator and /h2-console.")
    Container(kc, "Keycloak (x2, cluster)", "Keycloak 26, aisafe realm, :8180", "Login (OpenID Connect) and issuance of RS256 JWT with the profile (roles). Two nodes in a cluster (jdbc-ping) that publish the public key (JWKS).")
    ContainerDb(kcdb, "Keycloak DB", "PostgreSQL", "Realm, users and sessions (shared by the 2 nodes)")

    Container(fo, "Flight Operations Service", "Java 17, Spring Boot 4", "Scheduling, aircraft-route assignment, availability, flight lifecycle, aircraft reassignment (grounding). Replicas with asynchronous replication.")
    Container(ar, "Airports & Routes Service", "Java 17, Spring Boot 4", "Airports, runways, certifications, routes and history. Replicas with replication outbox.")
    Container(ac, "Aircraft Service", "Java 17, Spring Boot 4", "Aircraft models and instances, operational status. Replicas with asynchronous replication.")
    Container(mt, "Maintenance Service", "Java 17, Spring Boot 4", "Maintenance templates and records. Replicas; templates and records are both replicated to the peers by global id.")

    ContainerDb(fodb, "Flight Ops DB", "H2 (one per replica)", "Scheduled flights (replicated)")
    ContainerDb(ardb, "Airports & Routes DB", "H2 (one per replica)", "Airports and routes")
    ContainerDb(acdb, "Aircraft DB", "H2 (one per replica)", "Aircraft")
    ContainerDb(mtdb, "Maintenance DB", "H2 (one per replica)", "Maintenance")
}

Rel(user, gw, "Login and requests (Bearer JWT); if one gateway fails, uses the other", "HTTPS")
Rel(gw, kc, "/realms/... (login, JWKS), failover between the 2 nodes", "HTTP")
Rel(kc, kcdb, "Reads/Writes", "JDBC")
Rel(gw, fo, "/api/scheduled-flights/...", "HTTPS, round-robin")
Rel(gw, ar, "/api/airports/..., /api/routes/...", "HTTPS, round-robin")
Rel(gw, ac, "/api/aircraft/...", "HTTPS, round-robin")
Rel(gw, mt, "/api/maintenance/...", "HTTPS, round-robin")

Rel(fo, ar, "Validates route (active, capacity), failover between replicas", "HTTPS GET /api/routes/{id}, user's JWT")
Rel(fo, ac, "Validates aircraft (ACTIVE, range, capacity), failover between replicas", "HTTPS GET /api/aircraft/{reg}, user's JWT")
Rel(mt, ac, "Updates operational status", "HTTPS /internal/aircraft/instances/{reg}/maintenance-status, X-API-Key")
Rel(ac, fo, "Aircraft grounded: requests reassignment of future flights", "HTTPS POST /internal/.../grounding, X-API-Key")
Rel(fo, kc, "Public key to validate the JWT (every service does the same and caches the keys)", "JWKS")
Rel_L(fo, fo, "Replication and forwarding between replicas", "HTTPS /internal/..., X-API-Key")
Rel_L(ar, ar, "Replication (outbox) and forwarding between replicas", "HTTPS, HS256 peer token")
Rel_L(ac, ac, "Asynchronous replication and forwarding between replicas", "HTTPS /internal/..., X-API-Key")
Rel_L(mt, mt, "Replication of maintenance records between replicas", "HTTPS /internal/..., X-API-Key")
Rel(ac, ar, "Route data for the compatible-routes query, failover between replicas", "HTTPS GET /api/routes, user's JWT")

Rel(fo, fodb, "Reads/Writes", "JPA")
Rel(ar, ardb, "Reads/Writes", "JPA")
Rel(ac, acdb, "Reads/Writes", "JPA")
Rel(mt, mtdb, "Reads/Writes", "JPA")

@enduml