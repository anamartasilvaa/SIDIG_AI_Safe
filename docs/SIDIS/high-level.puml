@startuml high-level
title AISafe - High-level view
skinparam shadowing false

actor Client

package "AISafe" {

    [API Gateway (x2)] as GW

    node "Identity" {
        [Keycloak (x2)] as KC
        database "Keycloak DB" as KCDB
    }

    node "Aircraft Component (replicas)" {
        [Aircraft Service] as AC
        database "Aircraft DB" as ACDB
    }

    node "Maintenance Component (replicas)" {
        [Maintenance Service] as MT
        database "Maintenance DB" as MTDB
    }

    node "Airports & Routes Component (replicas)" {
        [Airports & Routes Service] as AR
        database "Airports DB" as ARDB
    }

    node "Flight Operations Component (replicas)" {
        [Flight Operations Service] as FO
        database "Flight Ops DB" as FODB
    }
}

Client --> GW : HTTPS/REST (Bearer JWT)
GW --> KC : /realms/... (login, JWKS)
KC --> KCDB

GW --> AC
GW --> MT
GW --> AR
GW --> FO

AC -down-> ACDB
MT -down-> MTDB
AR -down-> ARDB
FO -down-> FODB

MT .up.> AC : HTTPS (maintenance status)
FO <.up.> AC : HTTPS: aircraft validation and availability (FO to AC);\ngrounding, reassign flights (AC to FO)
FO .up.> AR : HTTPS (route validation)
AC .up.> AR : HTTPS (compatible routes)

@enduml
