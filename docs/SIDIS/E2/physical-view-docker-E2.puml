@startuml physical-view-docker-p2
title AISafe - Physical View (Secure Docker, docker-compose.secure.yml), second delivery
skinparam shadowing false
skinparam defaultFontSize 12
skinparam nodesep 25
skinparam ranksep 45

node "Client" as clientNode {
  artifact "Postman / curl\n(list of 2 URLs)" as postman
  artifact "Browser\n(RabbitMQ console)" as browser
}

node "Docker Engine (1 host)" as host {

  frame "'edge' network (published ports)" as edge {
    node "gateway-1\nNGINX :8443" as gw1
    node "gateway-2\nNGINX :8444" as gw2
  }

  frame "'backend' network (internal, no Internet access)" as backend {

    frame "Identity" as idg {
      node "keycloak-1 :8180" as kc1
      node "keycloak-2 :8180" as kc2
      database "keycloak-db-0\nPostgreSQL + repmgr" as kdb0
      database "keycloak-db-1\nPostgreSQL + repmgr" as kdb1
      database "keycloak-db-2\nPostgreSQL + repmgr" as kdb2
    }

    frame "Message broker (also on 'edge' for the console)" as mqg {
      queue "rabbitmq-1\nAMQPS :5671\nconsole 127.0.0.1:15672" as rb1
      queue "rabbitmq-2\nAMQPS :5671\nconsole 127.0.0.1:15673" as rb2
      queue "rabbitmq-3\nAMQPS :5671\nconsole 127.0.0.1:15674" as rb3
      node "rabbitmq-init\n(one-shot: definitions.json)" as rbi
    }

    frame "Flight Operations" as fog {
      node "flight-operations-1\n:8443 HTTPS" as fo1
      node "flight-operations-2\n:8443 HTTPS" as fo2
      database "fo-db-1\nPostgreSQL" as fdb1
      database "fo-db-2\nPostgreSQL" as fdb2
    }
    frame "Airports & Routes" as arg {
      node "airports-routes-1\n:8443 HTTPS" as ar1
      node "airports-routes-2\n:8443 HTTPS" as ar2
      database "airports-db-1\nPostgreSQL" as adb1
      database "airports-db-2\nPostgreSQL" as adb2
    }
    frame "Aircraft" as acg {
      node "aircraft-1\n:8443 HTTPS" as ac1
      node "aircraft-2\n:8443 HTTPS" as ac2
      database "aircraft-db-1\nPostgreSQL" as acdb1
      database "aircraft-db-2\nPostgreSQL" as acdb2
    }
    frame "Maintenance" as mtg {
      node "maintenance-1\n:8443 HTTPS" as mt1
      node "maintenance-2\n:8443 HTTPS" as mt2
      database "maintenance-db-1\nPostgreSQL" as mtdb1
      database "maintenance-db-2\nPostgreSQL" as mtdb2
    }
  }
}

postman --> gw1 : HTTPS :8443
postman --> gw2 : HTTPS :8444\n(if :8443 fails)
browser ..> rb1 : HTTP 127.0.0.1:15672\n(management only)

gw1 --> idg : /realms/... (failover between the 2 nodes)
kc1 --> kdb0 : JDBC (current primary)
kc2 --> kdb0
kdb0 ..> kdb1 : streaming replication
kdb0 ..> kdb2 : streaming replication

gw1 --> fog : round-robin + failover
gw1 --> arg
gw1 --> acg
gw1 --> mtg
gw2 .down.> fog : both gateways reach the same services

fo1 --> fdb1
fo2 --> fdb2
ar1 --> adb1
ar2 --> adb2
ac1 --> acdb1
ac2 --> acdb2
mt1 --> mtdb1
mt2 --> mtdb2

fo1 --> mqg : AMQPS (any of the 3 nodes)
fo2 --> mqg
ar1 --> mqg
ar2 --> mqg
ac1 --> mqg : AMQPS
ac2 --> mqg : AMQPS
mt1 --> mqg : AMQPS
mt2 --> mqg : AMQPS
rb1 <..> rb2 : cluster (Erlang cookie)
rb2 <..> rb3
rbi ..> rb1 : POST /api/definitions

mtg --> acg : /internal (status)
acg --> fog : /internal (grounding)

note bottom of host
  Volumes: Keycloak DBs, RabbitMQ nodes, FO DBs, Airports DBs,
  and dedicated aircraft-db-1/2 and maintenance-db-1/2 PostgreSQL volumes.
  All secrets come from .env (random values generated by gen-certs.ps1, outside Git).
  Remaining single point of failure: the Docker host itself (production: Swarm / Kubernetes, several hosts).
end note
@enduml
