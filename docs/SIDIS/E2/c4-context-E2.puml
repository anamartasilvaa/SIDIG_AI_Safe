@startuml c4-context-p2
!include <C4/C4_Context>
LAYOUT_TOP_DOWN()

title AISafe Flight Management System - C4 Level 1 (System Context), second delivery

Person(admin, "Admin", "Manages users and has access to all operations.")
Person(backoffice, "Backoffice Operator", "Manages airports, routes and aircraft; reads utilization reports and aircraft moods.")
Person(atcc, "ATCC", "Schedules flights, assigns aircraft to routes, follows flight status and aircraft moods.")
Person(maint, "Maintenance Technician / Supervisor", "Registers and validates aircraft maintenance.")

System(aisafe, "AISafe Flight Management System", "Distributed system: 2 API gateways + 4 services (Aircraft, Maintenance, Airports & Routes, Flight Operations), 2 replicas each, one database per replica. External API: HTTPS REST. Between services: asynchronous messages (AMQP, RabbitMQ cluster).")
System_Ext(idp, "Keycloak (aisafe realm)", "Identity provider (2 nodes, replicated PostgreSQL): authenticates users and issues signed JWTs (RS256) carrying the profile.")

Rel(admin, aisafe, "Uses", "HTTPS/REST, JSON")
Rel(backoffice, aisafe, "Uses", "HTTPS/REST, JSON")
Rel(atcc, aisafe, "Uses", "HTTPS/REST, JSON")
Rel(maint, aisafe, "Uses", "HTTPS/REST, JSON")
Rel(aisafe, idp, "Login (via gateway) and public key to validate tokens", "OpenID Connect / JWKS")

@enduml
