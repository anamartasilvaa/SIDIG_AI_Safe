@startuml sd-failure-recovery
skinparam style strictuml
autonumber
title SD - Failure and recovery scenarios (no single point of failure)

participant "API Gateway 1 / 2" as GW
box "FO-1" #F4F7FF
participant "FO-1" as F1
database "FO-1 DB" as D1
end box
box "RabbitMQ" #FFF8E8
participant "rabbitmq-1" as R1
participant "rabbitmq-2" as R2
participant "rabbitmq-3" as R3
end box
box "FO-2" #F4FFF4
participant "FO-2" as F2
database "FO-2 DB" as D2
end box

== A. One RabbitMQ node fails ==
R1 -> R1 : X stopped
F1 -> R2 : client reconnects (spring.rabbitmq.addresses = 3 nodes)

== B. The whole broker is unavailable ==
GW -> F1 : POST /api/scheduled-flights
F1 -> D1 : commit flight + outbox
F1 --> GW : 201 (writes keep working)
GW -> F2 : GET ... (reads keep working from the local views)

== C. FO-2 fails ==
GW -> F2 : request
F2 -> F2 : X down
GW -> F1 : proxy_next_upstream: same request to FO-1

== D. FO-2 restarts with its database intact ==
R2 -> F2 : backlog of fo.flights.fo-2 / fo.aircraft.fo-2 / fo.routes.fo-2
F2 -> D2 : idempotent apply (processed_event, revision)

== E. FO-2 starts with an EMPTY database (disk lost / new replica) ==
F2 -> F2 : SnapshotBootstrapper (background thread):\ncommand store empty -> snapshot needed
F2 -> F1 : GET /internal/scheduled-flights (X-API-Key)\nall flights as FlightState (retry every 5 s if FO-1 is down)
F1 --> F2 : snapshot (each item with its revision)
F2 -> D2 : apply each flight (command store + views);\nreferences fetched once by REST if missing
R2 -> F2 : queue backlog, consumed IN PARALLEL with the snapshot
F2 -> D2 : apply; older revisions ignored -> converges with no gap

== F. Aircraft and Airports & Routes completely down ==
GW -> F1 : POST /api/scheduled-flights
F1 -> D1 : validates with local AircraftRef / RouteRef (last known state)
F1 --> GW : 201 / 409 (503 only if the route or aircraft was never seen;\nstale references are the accepted AP trade-off)

== G. One gateway fails ==
GW -> GW : client uses the other gateway (:8443 <-> :8444)
@enduml
