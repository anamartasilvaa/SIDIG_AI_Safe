@startuml sd-aircraft-grounding
skinparam style strictuml
autonumber
title SD - Aircraft grounding by event (work queue fo.grounding)

actor "ATCC / Maintenance" as User
participant "Aircraft Service" as AC
box "RabbitMQ cluster" #FFF8E8
participant "aircraft.events" as EX
queue "fo.grounding\n(shared, quorum)" as QG
queue "fo.aircraft.fo-1 /\nfo.aircraft.fo-2" as QA
end box
box "ONE FO replica (competing consumers)" #F4F7FF
participant "GroundingEventListener" as GL
participant "AircraftGroundingHandler" as GH
participant "AircraftReferenceService" as Ref
participant "GroundingService" as GS
database "Replica DB" as DB
end box
participant "flights.events" as FEX

User -> AC : PATCH /api/aircraft-models/instances/{reg}/status\n(UNDER_MAINTENANCE)
AC -> EX : AircraftStatusChanged(reg, status, revision)
EX -> QA : aircraft.# (every FO replica: AircraftEventListener updates aircraft_ref)
EX -> QG : aircraft.status-changed (ONE copy for the whole FO service)
QG -> GL : deliver (only one of FO-1 / FO-2 gets it)
activate GL
GL -> GL : AircraftEventTranslator (ACL)\nmalformed -> reject -> fo.dead-letter
GL -> DB : BEGIN; processed_event(consumer = "fo.grounding", eventId)
GL -> GH : onAircraftStatus(change)
GH -> Ref : apply(change)
Ref -> DB : SELECT aircraft_ref ... FOR UPDATE;\nupdate only if newer (revision, then time)
GH -> Ref : isGrounded(reg)?
alt aircraft ACTIVE (or an old event: a newer ACTIVE status is already known)
  GH --> GL : nothing to do
else not ACTIVE
  GH -> GS : ground(reg)
  GS -> DB : future flights of reg (SCHEDULED / DELAYED)
  loop each affected flight (ordered by scheduled date)
    GS -> DB : candidates = aircraft_ref WHERE status = ACTIVE\nORDER BY registration_number
    GS -> GS : first candidate that fits the route\n(range, capacity) and has no 2 h conflict
    alt free candidate found
      GS -> DB : reassignAircraft (revision + 1) + outbox FlightReassigned
    else no candidate
      GS -> DB : DELAYED, reason NO_REPLACEMENT_AIRCRAFT\n(revision + 1) + outbox FlightStatusChanged
    end
  end
end
GL -> DB : COMMIT
GL -> QG : basicAck
deactivate GL
DB -> FEX : OutboxRelay publishes FlightReassigned / FlightStatusChanged
FEX -> QA : (fo.flights.*) every replica updates its copy and views

== Other triggers (same GroundingService, idempotent) ==

== Failures ==
@enduml
