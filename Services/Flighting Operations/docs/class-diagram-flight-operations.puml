@startuml class-diagram-flight-operations
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members
title Flight Operations - Write model, read model and events (CQRS)

package "Command side - schema command" #F4F7FF {
  class ScheduledFlight <<Aggregate Root>> {
    - flightId: FlightId
    - routeId: RouteId
    - aircraft: RegistrationNumber
    - scheduledDateTime: LocalDateTime
    - status: FlightStatus
    - revision: long
    - lastModifiedAt: Instant
    - originInstance: String
    --
    + {static} schedule(route, aircraft, when, now, instance): ScheduledFlight
    + changeStatus(next: FlightStatus, now)
    + reassignAircraft(newAircraft: RegistrationNumber)
    + applyReplica(event: IntegrationEvent): boolean
    + pullDomainEvents(): List<IntegrationEvent>
  }
  enum FlightStatus {
    SCHEDULED
    DELAYED
    IN_FLIGHT
    COMPLETED
    CANCELED
  }
  class FlightSchedulingPolicy <<Domain Service>> {
    + checkAssignment(RouteRef, AircraftRef)
    + findConflict(slots, when): Optional<FlightSlot>
  }
  class AircraftRef <<Local projection>> {
    registrationNumber: String
    modelCode: String
    status: String
    maximumRange: Double
    seatingCapacity: Integer
    revision: long
  }
  class RouteRef <<Local projection>> {
    routeId: String
    active: boolean
    distance: Double
    minimumCapacity: Integer
    revision: long
  }
  class OutboxEvent <<Transactional outbox>> {
    eventId: UUID
    routingKey: String
    payload: JSON
    createdAt: Instant
    sentAt: Instant
    attempts: int
  }
  class ProcessedEvent <<Idempotency>> {
    consumer: String
    eventId: UUID
    --
    PK (consumer, eventId)
    processedAt: Instant
  }
}

package "Query side - schema query (denormalised, no rules)" #F4FFF4 {
  class FlightView {
    flightId: String
    routeId: String
    origin: String
    destination: String
    registrationNumber: String
    scheduledDateTime: LocalDateTime
    status: String
    revision: long
  }
  class RouteUtilizationView {
    routeId: String
    origin: String
    destination: String
    flightCount: long
  }
  class AircraftScheduleView {
    registrationNumber: String
    aircraftStatus: String
    activeFlights: int
    nextFlightAt: LocalDateTime
  }
  class AircraftMoodView {
    registrationNumber: String
    mood: AircraftMood
    reason: String
    delayedOrCanceled: int
    flightsNext24h: int
    updatedAt: Instant
  }
  enum AircraftMood {
    HAPPY
    BUSY
    GRUMPY
    SLEEPING
  }
}

package "Integration events (AMQP, JSON)" #FFF8E8 {
  abstract class IntegrationEvent {
    eventId: UUID
    type: String
    version: int
    occurredAt: Instant
    aggregateId: String
    revision: long
    sourceInstance: String
    correlationId: String
  }
  class FlightScheduled
  class FlightStatusChanged {
    previous: FlightStatus
    current: FlightStatus
    reason: String
  }
  class FlightReassigned {
    fromAircraft: String
    toAircraft: String
  }
  class "AircraftRegistered /\nAircraftStatusChanged" as AircraftEvents <<consumed>>
  class "RouteCreated / RouteUpdated /\nRouteDeactivated" as RouteEvents <<consumed>>
}

ScheduledFlight --> FlightStatus
ScheduledFlight ..> FlightScheduled : raises
ScheduledFlight ..> FlightStatusChanged : raises
ScheduledFlight ..> FlightReassigned : raises
FlightSchedulingPolicy ..> AircraftRef : uses
FlightSchedulingPolicy ..> RouteRef : uses
IntegrationEvent <|-- FlightScheduled
IntegrationEvent <|-- FlightStatusChanged
IntegrationEvent <|-- FlightReassigned
IntegrationEvent <|-- AircraftEvents
IntegrationEvent <|-- RouteEvents
FlightScheduled ..> OutboxEvent : stored as
AircraftMoodView --> AircraftMood

FlightScheduled ..> FlightView : projected into
FlightScheduled ..> RouteUtilizationView : projected into
FlightScheduled ..> AircraftScheduleView : projected into
FlightStatusChanged ..> AircraftMoodView : projected into
AircraftEvents ..> AircraftRef : projected into
AircraftEvents ..> AircraftMoodView : projected into
RouteEvents ..> RouteRef : projected into
@enduml
