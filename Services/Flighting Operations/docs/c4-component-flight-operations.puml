@startuml c4-component-flight-operations
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam wrapWidth 220

title Flight Operations Service - C4 Level 3 (Components) - CQRS + AMQP

Person(client, "AISafe User", "ATCC, Backoffice, Admin")
Container_Ext(gateway, "API Gateways (x2)", "NGINX, HTTPS :8443 / :8444", "Round-robin between FO replicas; blocks /internal/...")
Container_Ext(keycloak, "Keycloak cluster (x2)", "aisafe realm", "Issues RS256 JWT; JWKS public key")
Container_Ext(broker, "RabbitMQ cluster (3 nodes)", "AMQP 0-9-1 over TLS, quorum queues", "Exchanges flights.events, aircraft.events, routes.events")
Container_Ext(peer, "Other FO replica", "Spring Boot", "Same components, own database")
Container_Ext(owners, "Aircraft / Airports & Routes", "Spring Boot (x2 each)", "Owners of the aircraft and route data")
ContainerDb(db, "FO database (one per replica)", "PostgreSQL", "Schema command: flights, references, outbox, processed events. Schema query: denormalised views.")

Container_Boundary(fo, "Flight Operations Service (one replica)") {

    Component(sec, "JwtAuthenticationFilter + SecurityConfig", "Spring Security, stateless", "Validates the RS256 JWT (JWKS, iss, exp); RBAC per endpoint; deny by default; AUDIT DENIED.")

    Boundary(cmd, "Command side (write model)") {
        Component(cmdCtrl, "ScheduledFlightController (write endpoints)", "@RestController /api/scheduled-flights", "POST (US212), PATCH /{id}/status. Returns 201/200 after the local commit.")
        Component(cmdSvc, "FlightCommandService", "@Service, @Transactional", "Loads the aggregate, applies the policy, saves the aggregate and the outbox event in ONE transaction.")
        Component(policy, "FlightSchedulingPolicy", "Domain service", "Active route, ACTIVE aircraft, range, capacity, 2 h conflicts.")
        Component(agg, "ScheduledFlight", "Aggregate root", "State machine, revision, reassignAircraft(), raises domain events.")
        Component(grounding, "GroundingEventListener + AircraftGroundingHandler", "@RabbitListener fo.grounding (competing consumers)", "On AircraftStatusChanged: updates aircraft_ref and, if the aircraft is not ACTIVE, calls GroundingService (free, compatible ACTIVE aircraft from the local reference data; otherwise DELAYED).")
        Component(conflict, "ConflictResolver", "@Component", "Deterministic rule for conflicts created during a partition: every replica elects the same winner; the losing flight is cancelled (idempotent compensation).")
    }

    Boundary(msg, "Messaging (AMQP)") {
        Component(outbox, "OutboxRelay", "@Scheduled + RabbitTemplate (publisher confirms)", "Publishes pending outbox rows to flights.events; marks them as sent only after the broker confirms.")
        Component(flightL, "FlightEventListener", "@RabbitListener fo.flights.<instance>", "Receives FlightScheduled / StatusChanged / Reassigned from ALL replicas (own included).")
        Component(refL, "RouteEventListener / AircraftEventListener", "@RabbitListener fo.routes.<instance>, fo.aircraft.<instance>", "Receives aircraft and route events from the other services.")
        Component(idem, "IdempotencyGuard", "processed_event table", "Ignores duplicated eventIds (at-least-once delivery).")
    }

    Boundary(qry, "Query side (read model)") {
        Component(qryCtrl, "ScheduledFlightController (read endpoints)", "@RestController /api/scheduled-flights", "GET /{id}, /aircraft/{reg} (US213), /availability (US205), /route-utilization (US229).")
        Component(qrySvc, "FlightQueryService", "@Service, read-only", "Reads only the denormalised views; no business rules. Availability of an aircraft never seen by this replica: one lookup through ReferenceDataService.")
        Component(proj, "Projectors", "FlightProjector", "Update the views (only newer revisions are applied).")
    }

    Component(refData, "ReferenceDataService + ReferenceWriter", "@Service / @Component", "Local copies route_ref, aircraft_ref. Missing reference: one REST lookup, inserted in its own transaction (safe under concurrency).")
    Component(errors, "GlobalExceptionHandler", "@RestControllerAdvice", "Own database unreachable -> 503 + Retry-After, so the gateway retries on the other replica.")
    Component(sync, "ReplicaSyncReconciler", "@Scheduled (20 s)", "Anti-entropy: compares the flights with the peer replica and applies missing or older ones (repairs events lost to the dead-letter queue).")
    Component(boot, "SnapshotBootstrapper", "ApplicationReadyEvent, background thread", "Only for an EMPTY database: copies all flights from the peer replica (retries every 5 s) while the queues are consumed; last-writer-wins makes the order irrelevant.")
    Component(audit, "AuditLog", "logger AUDIT", "Who created / changed each flight.")
}

Rel(client, gateway, "REST + Bearer JWT", "HTTPS")
Rel(gateway, sec, "Forwards", "HTTPS")
Rel(sec, keycloak, "Fetches public key", "JWKS")
Rel(sec, cmdCtrl, "POST / PATCH")
Rel(sec, qryCtrl, "GET")

Rel(cmdCtrl, cmdSvc, "Commands")
Rel(cmdCtrl, audit, "CREATE / UPDATE_STATUS")
Rel(cmdSvc, agg, "Creates / changes")
Rel(cmdSvc, policy, "Validates")
Rel(cmdSvc, db, "Aggregate + outbox row (1 transaction)", "JDBC")
Rel(grounding, db, "Reassigns flights + outbox (1 transaction)", "JDBC")
Rel(conflict, cmdSvc, "cancel (compensation)")

Rel(outbox, db, "Reads pending rows", "JDBC")
Rel(outbox, broker, "Publishes flight.*", "AMQPS")
Rel(broker, flightL, "fo.flights.<instance>", "AMQPS")
Rel(broker, refL, "fo.aircraft.<instance>, fo.routes.<instance>", "AMQPS")
Rel(broker, grounding, "fo.grounding", "AMQPS")
Rel(flightL, idem, "Checks eventId")
Rel(refL, idem, "Checks eventId")
Rel(flightL, proj, "Applies")
Rel(refL, proj, "Applies")
Rel(flightL, conflict, "Possible conflict")
Rel(proj, db, "Updates views + replicas", "JDBC")

Rel(qryCtrl, qrySvc, "Queries")
Rel(qrySvc, db, "Reads views", "JDBC")

Rel(boot, peer, "GET /internal/scheduled-flights", "HTTPS + X-API-Key")
Rel(sync, peer, "GET /internal/scheduled-flights every 20 s", "HTTPS + X-API-Key")
Rel(sync, proj, "Applies missing / older flights")
Rel(cmdSvc, refData, "ensureRoute / ensureAircraft")
Rel(qrySvc, refData, "ensureAircraft (availability)")
Rel(refData, owners, "Fallback lookup (once)", "HTTPS")
Rel(refData, db, "route_ref / aircraft_ref (own transaction)", "JDBC")
Rel(errors, gateway, "503 -> retry on the other replica")
Rel(peer, broker, "Publishes flight.*", "AMQPS")
@enduml
