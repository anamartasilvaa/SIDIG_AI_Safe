@startuml c4-component-flight-operations
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()

title Flight Operations Service - C4 Level 3 (Components)

Person(client, "AISafe User", "ATCC, Backoffice, Admin")
Container_Ext(gateway, "API Gateway", "NGINX, HTTPS :8443", "Routes in round-robin; blocks /internal/...")
Container_Ext(keycloak, "Keycloak", "aisafe realm", "Issues RS256 JWT; publishes public key (JWKS)")
Container_Ext(peers, "Other Flight Operations replicas", "Spring Boot", "8081 / 8082 / 8083")
Container_Ext(ar, "Airports & Routes Service", "Spring Boot", "8091-8093; validates the same JWT")
Container_Ext(am, "Aircraft Service", "Spring Boot", "8071-8073 (stub until it exists)")
ContainerDb(db, "Flight Ops DB", "In-memory H2", "One DB per replica")

Container_Boundary(fo, "Flight Operations Service (one replica)") {
    Component(jwt, "JwtAuthenticationFilter + TokenDecoders", "OncePerRequestFilter + NimbusJwtDecoder", "Validates JWT: RS256 from Keycloak (JWKS, iss, exp) or development HS256; reads user and roles.")
    Component(security, "SecurityConfig", "Spring Security, stateless", "RBAC per endpoint and method. Deny by default.")
    Component(problems, "SecurityProblemHandler", "EntryPoint + AccessDeniedHandler", "401 / 403 in ProblemDetail; AUDIT DENIED.")
    Component(filter, "ApiKeyFilter", "OncePerRequestFilter", "Requires X-API-Key on /internal/...; AUDIT ALLOWED/DENIED.")
    Component(pub, "ScheduledFlightController", "@RestController /api/scheduled-flights", "Public API: US212, US213, US205, US229, change state. HATEOAS.")
    Component(internal, "InternalScheduledFlightController", "@RestController /internal/scheduled-flights", "Local reads, local state, receive copies (/replica). Never forwards.")
    Component(audit, "AuditLog", "logger AUDIT", "Who created / changed each flight.")
    Component(handler, "GlobalExceptionHandler", "@RestControllerAdvice", "400 / 404 / 409 / 502 / 503 in ProblemDetail.")
    Component(service, "ScheduledFlightService", "@Service", "Local vs distributed, aggregation, AP/CP, aircraft lock, apply copies, sync on startup.")
    Component(policy, "FlightSchedulingPolicy", "Domain Service", "Active route, ACTIVE aircraft, range, capacity, 2h conflicts.")
    Component(domain, "ScheduledFlight + Value Objects", "JPA Aggregate", "FlightId, RouteId, RegistrationNumber, state machine, revision.")
    Component(validator, "FlightAssignmentValidator", "@Component + ACL", "Fetches route and aircraft (RouteInfo / AircraftInfo).")
    Component(replicator, "FlightReplicator", "@Component + scheduler", "Asynchronous replication: pending copies, resend every 5s.")
    Component(peerClient, "PeerClient", "@Component + thread pool", "findFirst, collectAll, forwardPut in parallel; partial responses.")
    Component(replicated, "ReplicatedServiceClient", "routesClient, aircraftClient", "Round-robin + failover between replicas of another service.")
    Component(caller, "RemoteCaller + CircuitBreaker", "@Component", "Timeouts 1s / 2s, retry with backoff, circuit breaker per destination.")
    Component(http, "HttpClientConfig", "RestTemplate (HTTPS + truststore)", "Sends X-API-Key and X-Origin-Instance; forwards the user's JWT.")
    Component(repo, "ScheduledFlightRepository", "Spring Data JPA", "Local DB.")
}

Rel(client, gateway, "Requests with Bearer JWT", "HTTPS")
Rel(client, keycloak, "Login (through gateway)", "OpenID Connect")
Rel(gateway, jwt, "Forwards request", "HTTPS")
Rel(jwt, keycloak, "Fetches public key", "JWKS")
Rel(jwt, security, "User + roles")
Rel(security, pub, "If role has permission")
Rel(security, problems, "401 / 403")
Rel(peers, filter, "Internal requests", "HTTPS + X-API-Key")
Rel(filter, internal, "If key is valid")

Rel(pub, service, "Uses")
Rel(pub, audit, "CREATE / UPDATE_STATUS")
Rel(internal, service, "Local methods and applyReplica")
Rel(service, validator, "Validates before creating")
Rel(validator, policy, "Delegates rules")
Rel(service, policy, "Detects conflicts")
Rel(service, domain, "Creates / updates / merges copies")
Rel(service, repo, "Uses")
Rel(service, replicator, "Replicates after saving")
Rel(service, peerClient, "Forwarding, aggregation and sync")
Rel(validator, replicated, "Queries route / aircraft")

Rel(replicator, caller, "PUT /replica")
Rel(peerClient, caller, "Uses")
Rel(replicated, caller, "Uses")
Rel(caller, http, "Uses")
Rel(http, peers, "/internal/scheduled-flights/...", "HTTPS + X-API-Key")
Rel(http, ar, "GET /api/routes/{id}", "HTTPS + Bearer JWT")
Rel(http, am, "GET /api/aircraft/{reg}", "HTTPS (HTTP in stub) + Bearer JWT")
Rel(repo, db, "Reads/Writes", "JDBC")
Rel_L(handler, pub, "Translates exceptions")

@enduml