@startuml sd-get-flight-forwarding
skinparam style strictuml
autonumber
title SD - Get Scheduled Flight by id (forwarding peer-to-peer)

actor "Backoffice Operator" as User
box "FO-1 :8081" #F4F7FF
participant "ScheduledFlightController" as Ctrl
participant "ScheduledFlightService" as Svc
participant "ScheduledFlightRepository" as Repo
participant "PeerClient" as Peers
participant "RemoteCaller\n(+ CircuitBreaker)" as Caller
end box
box "FO-2 :8082" #F4FFF6
participant "ApiKeyFilter" as F2
participant "InternalScheduledFlightController" as Int2
end box
box "FO-3 :8083" #FFF8F0
participant "InternalScheduledFlightController" as Int3
end box

User -> Ctrl : GET /api/scheduled-flights/{id}
activate Ctrl
Ctrl -> Svc : findById(id)
activate Svc
Svc -> Svc : FlightId.of(id)
note right : id that is not a UUID -> 400\n(without going to the network)
Svc -> Repo : findByFlightId_Uuid(id)
activate Repo
Repo --> Svc : Optional.empty()
deactivate Repo

Svc -> Peers : findFirst("/internal/scheduled-flights/{id}")
activate Peers
par requests in parallel
  Peers -> Caller : get(FO-2)
  activate Caller
  Caller -> F2 : GET /internal/... (X-API-Key)
  activate F2
  F2 -> Int2 : valid key (AUDIT ALLOWED)
  activate Int2
  Int2 --> Caller : 200 ScheduledFlightViewDTO
  deactivate Int2
  deactivate F2
  Caller --> Peers : Optional[flight]
  deactivate Caller
else
  Peers -> Int3 : GET /internal/... (X-API-Key)
  activate Int3
  Int3 --> Peers : 404 (only sees local data)
  deactivate Int3
end
Peers --> Svc : Optional[flight] (first response found)
deactivate Peers
Svc --> Ctrl : ScheduledFlightViewDTO
deactivate Svc
Ctrl --> User : 200 OK (EntityModel)
deactivate Ctrl

@enduml