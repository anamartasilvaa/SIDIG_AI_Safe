@startuml sd-change-flight-status
skinparam style strictuml
autonumber
title SD - Change Flight Status (write forwarding to the owner replica)

actor "Backoffice Operator" as User
box "FO-1 :8081 (receives the request)" #F4F7FF
participant "ScheduledFlightController" as Ctrl
participant "ScheduledFlightService" as Svc
participant "ScheduledFlightRepository" as Repo
participant "PeerClient" as Peers
end box
box "FO-2 :8082 (owns the flight)" #F4FFF6
participant "InternalScheduledFlightController" as Int2
participant "ScheduledFlightService" as Svc2
participant "ScheduledFlight" as Flight
participant "ScheduledFlightRepository" as Repo2
end box
participant "FO-3 :8083\n/internal" as FO3

User -> Ctrl : PATCH /api/scheduled-flights/{id}/status {"status":"DELAYED"}
activate Ctrl
Ctrl -> Svc : changeStatus(id, "DELAYED")
activate Svc
Svc -> Svc : FlightStatus.parse("DELAYED")
note right : unknown status -> 400
Svc -> Repo : findByFlightId_Uuid(id)
activate Repo
Repo --> Svc : Optional.empty() (not from this replica)
deactivate Repo

Svc -> Peers : forwardPut("/internal/scheduled-flights/{id}/status", status)
activate Peers
par in parallel
  Peers -> Int2 : PUT /internal/.../status (X-API-Key)
  activate Int2
  Int2 -> Svc2 : changeLocalStatus(id, DELAYED)
  activate Svc2
  Svc2 -> Repo2 : findByFlightId_Uuid(id)
  activate Repo2
  Repo2 --> Svc2 : Optional<ScheduledFlight>
  deactivate Repo2
  Svc2 -> Flight : changeStatus(DELAYED, now)
  activate Flight
  note right of Flight : state machine in the aggregate\nsame state -> no effect (idempotent)
  Flight --> Svc2 : ok
  deactivate Flight
  Svc2 -> Repo2 : save(flight)
  activate Repo2
  Repo2 --> Svc2 : savedFlight
  deactivate Repo2
  Svc2 --> Int2 : ScheduledFlightViewDTO
  deactivate Svc2
  Int2 --> Peers : 200 ScheduledFlightViewDTO
  deactivate Int2
else
  Peers -> FO3 : PUT /internal/.../status (X-API-Key)
  activate FO3
  FO3 --> Peers : 404 (not the owner)
  deactivate FO3
end
Peers --> Svc : Optional[updated flight]
deactivate Peers
Svc --> Ctrl : ScheduledFlightViewDTO

alt valid transition
  Ctrl --> User : 200 OK (EntityModel)
else invalid transition (e.g., IN_FLIGHT -> CANCELED)
  Int2 --> Peers : 409
  Peers --> Svc : SchedulingRuleViolation (propagated)
  Ctrl --> User : 409 Conflict
else no replica has the flight
  Ctrl --> User : 404 Not Found
end
deactivate Svc
deactivate Ctrl
@enduml