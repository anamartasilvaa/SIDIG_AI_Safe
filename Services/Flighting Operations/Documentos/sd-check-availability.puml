@startuml sd-check-availability
skinparam style strictuml
autonumber
title SD - Check Aircraft Availability (cross-service)

actor "Backoffice Operator" as User
box "FO-1 :8081" #F4F7FF
participant "ScheduledFlightController" as Ctrl
participant "ScheduledFlightService" as Svc
participant "FlightAssignmentValidator" as Val
participant "FlightSchedulingPolicy" as Policy
participant "PeerClient" as Peers
participant "ScheduledFlightRepository" as Repo
end box
participant "Aircraft\nService" as AC
participant "FO-2 / FO-3\n/internal" as FO
participant "AvailabilityDTO" as DTO

User -> Ctrl : GET /api/scheduled-flights/availability?registrationNumber=CS-TTA&dateTime=...
activate Ctrl
Ctrl -> Svc : checkAvailability(registration, dateTime)
activate Svc

Svc -> Val : findAircraft(registration)
activate Val
Val -> AC : GET /api/aircraft/{registration}
activate AC
alt Aircraft Service available
  AC --> Val : 200 AircraftInfo
  Val --> Svc : Optional<AircraftCapabilities>
  note right of Svc : status != ACTIVE -> reason "UNDER_MAINTENANCE"
else all replicas down
  AC --> Val : failure
  Val --> Svc : DependencyUnavailableException
  note right of Svc : reason "status unconfirmed"\n(graceful degradation, not 503)
end
deactivate AC
deactivate Val

Svc -> Repo : findByAircraft_Number(registration)
activate Repo
Repo --> Svc : local flights
deactivate Repo
Svc -> Peers : collectAll("/internal/scheduled-flights/aircraft/{reg}")
activate Peers
par in parallel
  Peers -> FO : GET (X-API-Key)
  activate FO
  FO --> Peers : List<ScheduledFlightViewDTO>
  deactivate FO
end
Peers --> Svc : AggregatedResult
deactivate Peers

Svc -> Policy : findConflict(slots, dateTime)
activate Policy
Policy --> Svc : Optional<FlightSlot>
deactivate Policy

Svc -> DTO ** : new AvailabilityDTO(available, aircraftStatus, conflictingFlightId, reasons, unreachablePeers)
Svc --> Ctrl : AvailabilityDTO
deactivate Svc
Ctrl --> User : 200 OK (available = reasons empty)
deactivate Ctrl
@enduml