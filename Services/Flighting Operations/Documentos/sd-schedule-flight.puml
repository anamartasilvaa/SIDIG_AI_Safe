@startuml sd-schedule-flight
skinparam style strictuml
autonumber
title SD - End-to-end flight scheduling (Keycloak + gateway + validation + replication)

actor "ATCC" as User
participant "API Gateway\n(NGINX :8443)" as GW
participant "Keycloak\n(aisafe realm)" as KC
box "FO-2 (replica chosen by gateway)" #F4F7FF
participant "JwtAuthenticationFilter\n+ SecurityConfig" as Sec
participant "ScheduledFlightController" as Ctrl
participant "ScheduledFlightService" as Svc
participant "FlightAssignmentValidator" as Val
participant "FlightSchedulingPolicy" as Policy
participant "PeerClient" as Peers
participant "ScheduledFlightRepository" as Repo
participant "FlightReplicator" as Rep
end box
participant "Airports & Routes" as AR
participant "Aircraft" as AC
participant "FO-1 / FO-3\n/internal" as FO

== 0. Authentication ==
User -> GW : POST /realms/aisafe/.../token (user, password)
GW -> KC : forwards
KC --> GW : access_token (JWT RS256, roles=[ATCC])
GW --> User : 200 access_token

== 1. Request through gateway ==
User -> GW : POST /api/scheduled-flights\nAuthorization: Bearer <JWT>
GW -> Sec : HTTPS (Host :8443, X-Request-Id)
activate Sec
Sec -> Sec : validates signature (Keycloak JWKS public key),\niss and exp; reads user and roles
alt token missing / invalid / forged / expired
  Sec --> GW : 401 ProblemDetail (AUDIT DENIED 401)
  GW --> User : 401
else role without permission (e.g., BACKOFFICE)
  Sec --> GW : 403 ProblemDetail (AUDIT DENIED 403)
  GW --> User : 403
end
Sec -> Ctrl : ATCC authorized
deactivate Sec
activate Ctrl
Ctrl -> Svc : scheduleFlight(dto)
activate Svc

== 2. Aggregate invariants (no remote calls) ==
Svc -> Svc : new ScheduledFlight(route, aircraft, date, now)
Svc -> Svc : lock(registration)

== 3. Validation in other services (with user's JWT) ==
Svc -> Val : validate(routeId, registration)
activate Val
Val -> AR : GET /api/routes/{id} + Bearer JWT
AR --> Val : 200 RouteInfo (status, minimumCapacity)
Val -> AC : GET /api/aircraft/{reg} + Bearer JWT
AC --> Val : 200 AircraftInfo (status, range, seats)
Val -> Policy : checkAssignment(route, aircraft)
Policy --> Val : ok
Val --> Svc : ok
deactivate Val

== 4. Schedule conflicts across all replicas ==
Svc -> Repo : local flights for the aircraft (already includes replicated ones)
Repo --> Svc : List<ScheduledFlight>
Svc -> Peers : collectAll(/internal/.../aircraft/{reg})
activate Peers
par in parallel
  Peers -> FO : GET (X-API-Key)
  FO --> Peers : List<ScheduledFlightViewDTO>
end
Peers --> Svc : AggregatedResult(items, unreachablePeers)
deactivate Peers
Svc -> Policy : findConflict(slots, date)
Policy --> Svc : Optional<FlightSlot>

== 5. Result ==
alt all valid
  Svc -> Repo : save(flight)
  Svc -> Rep : replicate(flight)
  Svc --> Ctrl : ScheduleResultDTO
  Ctrl --> GW : 201 Created + Location (https://localhost:8443/...)\n[+ X-Partial-Response-Unreachable-Peers if any peer failed (AP)]
  GW --> User : 201 (X-Served-By: 127.0.0.1:8082)
else inactive route, aircraft in maintenance, capacity/range, 2h conflict
  Ctrl --> GW : 409 ProblemDetail
  GW --> User : 409
else CP mode and some peer unresponsive
  Ctrl --> GW : 503 (cannot guarantee absence of conflicts)
  GW --> User : 503
else Airports & Routes or Aircraft completely down
  Ctrl --> GW : 503 Service Unavailable
  GW --> User : 503
end
deactivate Svc
deactivate Ctrl
@enduml