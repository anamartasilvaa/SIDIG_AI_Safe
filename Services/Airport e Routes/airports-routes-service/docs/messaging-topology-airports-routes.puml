@startuml messaging-topology-airports-routes
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
}
left to right direction
title Airports & Routes - AMQP topology (RabbitMQ cluster, fanout pub/sub, quorum queues)

package "Publishers (Transactional Outbox)" {
  rectangle "airports-routes-1\nAmqpReplicationPublisher\n(every 2 s, max 100 tasks)" as pub1 #DDEBFF
  rectangle "airports-routes-2\nAmqpReplicationPublisher\n(every 2 s, max 100 tasks)" as pub2 #DDEBFF
}

package "RabbitMQ cluster (rabbitmq-1/2/3, AMQPS 5671)" {
  collections "airports.events\n<<fanout exchange, durable>>" as ex #FFF4D6

  queue "airports.events.airports-routes-1\n<<quorum, durable>>\nTTL 1 h, max-length 10000" as q1
  queue "airports.events.airports-routes-2\n<<quorum, durable>>\nTTL 1 h, max-length 10000" as q2
  queue "airports.events.airports-routes-1.dlq\n<<quorum>> max-length 10000" as dlq1 #FFE0E0
  queue "airports.events.airports-routes-2.dlq\n<<quorum>> max-length 10000" as dlq2 #FFE0E0

  queue "fo.routes.flight-operations-1\n(declared by Flight Operations)" as qf1 #EEEEEE
  queue "fo.routes.flight-operations-2\n(declared by Flight Operations)" as qf2 #EEEEEE
}

package "Consumers" {
  rectangle "airports-routes-1\nReplicationEventConsumer" as c1 #DDEBFF
  rectangle "airports-routes-2\nReplicationEventConsumer" as c2 #DDEBFF
  rectangle "flight-operations-1 / -2\nlocal copy of routes" as cf #EEEEEE
}

pub1 --> ex : AIRPORT_CREATED / DETAILS_UPDATED / STATUS_CHANGED\nROUTE_CREATED / UPDATED / DEACTIVATED
pub2 --> ex

ex --> q1
ex --> q2
ex --> qf1
ex --> qf2

q1 --> c1
q2 --> c2
qf1 --> cf
qf2 --> cf

q1 ..> dlq1 : rejected after 3 attempts,\nexpired (TTL) or overflow\n(dead-letter via default exchange)
q2 ..> dlq2

note bottom of ex
  Event envelope (JSON, persistent):
  taskId, eventType, method, path, payload,
  originalUser, lastModified, originNodeId.
  messageId = <originNodeId>-<taskId>.
  Publisher confirms: the outbox task is only marked DONE
  after the broker ack (at-least-once delivery).
  One outbox task per event (not one per peer).
end note

note bottom of q1
  One quorum queue per instance = every instance receives
  every event (pub/sub). If an instance is down, its queue
  buffers the events (until the 1 h TTL).
  Consumers ignore events with their own originNodeId and
  apply the rest idempotently (last-writer-wins: lastModified,
  tie-break by originNodeId).
end note
@enduml
