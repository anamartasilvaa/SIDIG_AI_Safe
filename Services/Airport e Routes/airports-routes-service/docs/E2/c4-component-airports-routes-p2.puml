@startuml c4-component-airports-routes-p2
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()

title Airports & Routes - Componentes (C4 nível 3, Entrega 2: CQRS + RabbitMQ)

Person(client, "Utilizador AISafe", "ATCC, Backoffice, Admin")
Container_Ext(gateway, "API Gateway", "NGINX, HTTPS :8443", "Round-robin entre instâncias")
Container_Ext(broker, "RabbitMQ", "exchange airports.events (fanout)", "Uma fila + DLQ por instância")
Container_Ext(fo, "Flight Operations", "Spring Boot", "Guarda uma cópia local das rotas")
Container_Ext(peer, "Outra instância do Airports", "Spring Boot", "Só usada no arranque com a BD vazia")

ContainerDb(db, "airports-db-N", "PostgreSQL 16 (Modo B) / H2 em ficheiro (Modo A)", "Uma BD por instância: modelo de escrita, modelo de leitura, outbox e inbox")

Container_Boundary(ar, "Airports & Routes (uma instância)") {
    Component(ctrl, "AirportController / RouteController", "@RestController", "POST/PATCH vão para os comandos; GET vai para as consultas.")
    Component(admin, "AdminReplicationController", "@RestController (ADMIN)", "Mostra o estado da outbox (PENDING / DONE / FAILED).")
    Component(errors, "GlobalExceptionHandler", "@RestControllerAdvice", "BD em baixo -> 503, para a gateway repetir na outra instância.")

    Component(cmdSvc, "AirportService / RouteService", "@Service (ESCRITA)", "Regras de negócio. Também aplicam os eventos recebidos (last-writer-wins).")
    Component(proj, "AirportProjector / RouteProjector", "@Component", "Atualizam o modelo de leitura na mesma transação.")
    Component(qrySvc, "AirportQueryService / RouteQueryService", "@Service (LEITURA)", "Só leem o modelo de leitura local. Nunca chamam outra instância.")
    Component(bfs, "FastestRouteStrategy", "@Component", "Rotas alternativas (pesquisa em largura) no modelo de leitura.")

    Component(writeRepo, "AirportRepository / RouteRepository", "Spring Data JPA", "Modelo de ESCRITA (agregados).")
    Component(readRepo, "AirportReadRepository / RouteReadRepository", "Spring Data JPA", "Modelo de LEITURA (tabelas simples).")
    Component(rebuild, "ReadModelRebuilder", "CommandLineRunner", "No arranque, refaz o modelo de leitura a partir do de escrita.")
    Component(snap, "SnapshotBootstrapper", "@Component", "BD vazia no arranque -> copia aeroportos e rotas da outra instância.")
    Component(internal, "InternalSnapshotController", "@RestController (ROLE_PEER)", "GET /internal/snapshot (a gateway bloqueia /internal/).")
    Component(flyway, "Flyway", "db/migration (V1, V2)", "Cria o esquema da BD. O Hibernate não o altera.")

    Component(outbox, "ReplicationOutbox", "@Service", "Grava o evento na mesma transação do comando.")
    Component(pub, "AmqpReplicationPublisher", "@Scheduled (2 s)", "Publica os eventos PENDING. DONE só com confirmação do broker.")
    Component(cons, "ReplicationEventConsumer", "@RabbitListener", "Lê a fila desta instância. Ignora os seus próprios eventos. 3 tentativas -> DLQ.")
    Component(inbox, "IdempotencyGuard", "@Component (inbox)", "Cada evento só é aplicado uma vez (processed_event).")
}

Rel(client, gateway, "Pedido com JWT", "HTTPS")
Rel(gateway, ctrl, "Encaminha", "HTTPS")
Rel(gateway, admin, "Só ADMIN", "HTTPS")

Rel(ctrl, cmdSvc, "Comandos")
Rel(ctrl, qrySvc, "Consultas")
Rel(cmdSvc, writeRepo, "Grava")
Rel(cmdSvc, proj, "project()")
Rel(proj, readRepo, "Grava vista")
Rel(cmdSvc, outbox, "Evento")
Rel(outbox, db, "replication_task (PENDING)", "JDBC")
Rel(pub, broker, "Publica", "AMQP + confirms")
Rel(broker, cons, "Entrega na fila desta instância", "AMQP")
Rel(broker, fo, "Mesmos eventos, fila do FO", "AMQP")
Rel(cons, inbox, "runOnce(eventId)")
Rel(inbox, cmdSvc, "Aplica (isReplication=true)")
Rel(inbox, db, "processed_event", "JDBC")
Rel(qrySvc, readRepo, "Lê")
Rel(bfs, readRepo, "Rotas ativas")
Rel(admin, db, "Lê a outbox", "JDBC")
Rel(rebuild, writeRepo, "Lê tudo no arranque")
Rel(rebuild, proj, "Volta a projetar")
Rel(snap, peer, "GET /internal/snapshot (uma vez)", "HTTPS + JWT ROLE_PEER")
Rel(snap, cmdSvc, "applySnapshot()")
Rel(internal, cmdSvc, "exportSnapshot()")
Rel(flyway, db, "Migrações SQL", "JDBC")
Rel(writeRepo, db, "JDBC")
Rel(readRepo, db, "JDBC")
@enduml
