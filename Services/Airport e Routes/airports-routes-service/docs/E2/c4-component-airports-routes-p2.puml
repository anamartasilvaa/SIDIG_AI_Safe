@startuml c4-component-airports-routes-p2
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()
skinparam wrapWidth 220

title Airports & Routes - Componentes (C4 nível 3, Entrega 2: CQRS + RabbitMQ)

Person(client, "Utilizador AISafe", "ATCC, Backoffice, Admin")
Container_Ext(gateway, "API Gateways (x2)", "NGINX, HTTPS :8443 / :8444", "Round-robin entre instâncias; bloqueia /internal/")
Container_Ext(keycloak, "Keycloak (x2)", "realm aisafe", "Emite os JWT (RS256) e publica a chave pública")
Container_Ext(broker, "RabbitMQ (3 nós)", "AMQPS, filas quorum", "Exchange airports.events (fanout)")
Container_Ext(fo, "Flight Operations", "Spring Boot (x2)", "Guarda uma cópia local das rotas")
Container_Ext(peer, "Outra instância do Airports", "Spring Boot", "Mesmos componentes, BD própria")
ContainerDb(db, "airports-db-N (uma por instância)", "PostgreSQL 16 (Modo B) / H2 (Modo A)", "Modelo de escrita, modelo de leitura, outbox e inbox. Esquema criado pelo Flyway.")

Container_Boundary(ar, "Airports & Routes (uma instância)") {

    Component(sec, "JwtAuthenticationFilter + SecurityConfig", "Spring Security", "Valida o JWT e o perfil. Sem token: 401. Sem permissão: 403.")
    Component(errors, "GlobalExceptionHandler", "@RestControllerAdvice", "400 / 404 / 409 sem stack trace. BD em baixo: 503 -> a gateway tenta a outra instância.")

    Boundary(cmd, "Lado dos comandos (escrita)") {
        Component(ctrlW, "AirportController / RouteController (POST, PATCH)", "@RestController", "Criar e alterar aeroportos e rotas; importar CSV.")
        Component(cmdSvc, "AirportService / RouteService", "@Service, @Transactional", "Regras de negócio. Grava agregado + leitura + outbox numa só transação. Também aplica os eventos recebidos (last-writer-wins).")
        Component(writeRepo, "AirportRepository / RouteRepository / RouteHistoryRepository", "Spring Data JPA", "Modelo de escrita.")
        Component(admin, "AdminReplicationController", "@RestController (ADMIN)", "Estado da outbox: PENDING / DONE / FAILED.")
    }

    Boundary(msg, "Mensagens (AMQP)") {
        Component(outbox, "ReplicationOutbox", "@Service", "Grava o evento (ReplicationTask, eventId UUID) na transação do comando.")
        Component(pub, "AmqpReplicationPublisher", "@Scheduled (2 s)", "Publica as tarefas PENDING. DONE só com a confirmação do broker.")
        Component(cons, "ReplicationEventConsumer", "@RabbitListener", "Lê a fila desta instância. Ignora os próprios eventos. 3 tentativas -> DLQ.")
        Component(inbox, "IdempotencyGuard", "tabela processed_event", "Cada eventId só é aplicado uma vez.")
    }

    Boundary(qry, "Lado das consultas (leitura)") {
        Component(ctrlR, "AirportController / RouteController (GET)", "@RestController", "Pesquisas, histórico, estatísticas, GeoJSON, rotas alternativas.")
        Component(qrySvc, "AirportQueryService / RouteQueryService", "@Service", "Só leem o modelo de leitura local. Nunca chamam outra instância.")
        Component(bfs, "FastestRouteStrategy", "@Component", "Rotas alternativas (pesquisa em largura).")
        Component(proj, "AirportProjector / RouteProjector", "@Component", "Atualizam o modelo de leitura na transação do comando.")
        Component(readRepo, "AirportReadRepository / RouteReadRepository", "Spring Data JPA", "airport_read_model / route_read_model.")
    }

    Boundary(boot, "Arranque") {
        Component(flyway, "Flyway", "db/migration (V1, V2)", "Cria o esquema. O Hibernate não o altera.")
        Component(rebuild, "ReadModelRebuilder", "CommandLineRunner", "Refaz o modelo de leitura a partir do de escrita.")
        Component(snap, "SnapshotBootstrapper", "ApplicationReadyEvent", "BD vazia -> copia aeroportos e rotas da outra instância (tenta até ela responder).")
        Component(internal, "InternalSnapshotController", "@RestController (ROLE_PEER)", "GET /internal/snapshot.")
    }
}

Rel(client, gateway, "REST + JWT", "HTTPS")
Rel(gateway, sec, "Encaminha", "HTTPS")
Rel(sec, keycloak, "Chave pública", "JWKS")
Rel(sec, ctrlW, "POST / PATCH")
Rel(sec, ctrlR, "GET")
Rel(gateway, admin, "Só ADMIN", "HTTPS")

Rel(ctrlW, cmdSvc, "Comandos")
Rel(cmdSvc, writeRepo, "Grava")
Rel(cmdSvc, proj, "project()")
Rel(cmdSvc, outbox, "Evento")
Rel(writeRepo, db, "JDBC")
Rel(outbox, db, "replication_task", "JDBC")
Rel(admin, db, "Lê a outbox", "JDBC")

Rel(pub, db, "Lê PENDING", "JDBC")
Rel(pub, broker, "Publica AIRPORT_* / ROUTE_*", "AMQPS + confirms")
Rel(broker, cons, "airports.events.<instância>", "AMQPS")
Rel(broker, fo, "fo.routes.<instância>", "AMQPS")
Rel(cons, inbox, "Já processado?")
Rel(inbox, cmdSvc, "Aplica (isReplication=true)")
Rel(inbox, db, "processed_event", "JDBC")
Rel(peer, broker, "Publica os seus eventos", "AMQPS")

Rel(ctrlR, qrySvc, "Consultas")
Rel(qrySvc, readRepo, "Lê")
Rel(qrySvc, bfs, "Alternativas")
Rel(bfs, readRepo, "Rotas ativas")
Rel(proj, readRepo, "Grava vistas")
Rel(readRepo, db, "JDBC")

Rel(flyway, db, "Migrações", "JDBC")
Rel(rebuild, proj, "Volta a projetar tudo")
Rel(snap, peer, "GET /internal/snapshot (uma vez)", "HTTPS + JWT ROLE_PEER")
Rel(snap, cmdSvc, "applySnapshot()")
Rel(internal, cmdSvc, "exportSnapshot()")
Rel(errors, gateway, "503 -> tenta a outra instância")
@enduml
