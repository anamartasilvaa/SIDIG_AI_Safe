@startuml class-diagram-airports-routes
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members
title Airports & Routes - Modelo de domínio (escrita) + modelo de leitura (CQRS) + outbox/inbox

package "Agregado Airport" {
    class Airport <<Entity>> <<Root>> {
- pk: Long
- version: Long
- lastModified: Instant
- originNodeId: String
- name: String
- city: String
- country: String
- timezone: String
- imageUrl: String
- operationalHours: String
- contactInformation: String

        --
        + updateDetails(hours, contact)
        + updateImage(url)
        + updateStatus(status)
        + applyReplicationData(...)
        + applyReplicationMetadata(time, node)
    }
    class IATACode <<Value Object>> {
- code: String
    }
    enum AirportType <<Enumeration>> {
        INTERNATIONAL, REGIONAL, DOMESTIC
    }
    enum AirportStatus <<Enumeration>> {
        OPERATIONAL, CLOSED, UNDER_MAINTENANCE
    }
    class Coordinates <<Value Object>> {
- latitude: Double
- longitude: Double
    }
    class Runway <<Entity>> {
- name: String
- length: Double
- orientation: String
    }
    class Facility <<Value Object>> {
- type: String
- description: String
    }

    Airport "1" *-- "1" IATACode : identificado por >
    Airport "1" *-- "1" Coordinates : localizado em >
    Airport "1" --> "1" AirportStatus : tem >
    Airport "1" --> "1" AirportType : é do tipo >
    Airport "1" *-- "*" Runway : contém >
    Airport "1" *-- "*" Facility : tem >

    note right of Airport
      lastModified + originNodeId:
      servem para o last-writer-wins.
    end note
}

package "Agregado Route" {
    class Route <<Entity>> <<Root>> {
- pk: Long
- version: Long
- lastModified: Instant
- originNodeId: String
- estimatedFlightTime: Integer
- minimumRange: Double
- minimumCapacity: Integer

        --
        + deactivate()
        + updateParameters(time, range, capacity)
        + applyReplicationData(...)
        + applyReplicationMetadata(time, node)
    }
    class RouteId <<Value Object>> {
- id: String
    }
    enum RouteStatus <<Enumeration>> {
        ACTIVE, INACTIVE
    }

    Route "1" *-- "1" RouteId : identificada por >
    Route "1" --> "1" RouteStatus : tem >
    Route "*" --> "1" Airport : origem >
    Route "*" --> "1" Airport : destino >
}

package "Histórico de rotas" {
    class RouteHistory <<Entity>> {
- pk: Long
- routeId: String
- action: String
- startDate: LocalDateTime
- endDate: LocalDateTime

        --
        + closeHistory(endDate)
    }
    Route ..> RouteHistory : regista >
    note bottom of RouteHistory
      Datas = hora do evento (UTC),
      iguais em todas as instâncias.
    end note
}

package "Mensagens (outbox + inbox)" {
    class ReplicationTask <<Outbox>> {
- id: Long
- peerUrl: String
- httpMethod: String
- path: String
- payload: String
- attempts: int
- nextAttemptAt: Instant
- createdAt: Instant
- originalUser: String
- lastModified: Instant
- originNodeId: String
- eventId: String (UUID)

        --
        + markDone()
        + fail(nextInstant)
    }

    enum Status <<Enumeration>> {
        PENDING, DONE, FAILED
    }
    ReplicationTask "1" --> "1" Status

    class ProcessedEvent <<Inbox>> {
- id: Long
- consumer: String
- eventId: String
- eventType: String
- processedAt: Instant
    }
    note bottom of ReplicationTask
      Outbox: gravada na MESMA transação
      do comando -> nenhum evento se perde.
      Uma tarefa por evento.
    end note
    note bottom of ProcessedEvent
      Inbox: (consumer, eventId) é único
      -> cada evento só é aplicado uma vez.
    end note
}

package "Modelo de leitura (CQRS)" {
    class AirportReadModel <<Read Model>> {
- iataCode: String  {id}
- name: String
- city: String
- country: String
- status: String
- lastModified: Instant
- originNodeId: String
- viewJson: String
    }
    class RouteReadModel <<Read Model>> {
- routeId: String  {id}
- originIata: String
- destinationIata: String
- status: String
- minimumCapacity: Integer
- minimumRange: Double
- estimatedFlightTime: Integer
- originLatitude / originLongitude: Double
- destinationLatitude / destinationLongitude: Double
- lastModified: Instant
- originNodeId: String
    }
    note bottom of RouteReadModel
      Tabelas simples, sem joins.
      Só os projetores escrevem aqui.
      Refeitas no arranque se for preciso.
    end note
}

note as Schema
  Todas as tabelas são criadas pelo Flyway (V1, V2).
  O Hibernate só as lê (ddl-auto=none).
end note

Airport ..> AirportReadModel : projetado em >
Route ..> RouteReadModel : projetada em >

@enduml
