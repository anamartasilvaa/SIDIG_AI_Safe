@startuml class-diagram-airports-routes
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
hide empty members
title Airports & Routes Service - Domain Model (write side) + CQRS read model + outbox

package "Airport Aggregate" {
    class Airport <<Entity>> <<Root>> {
- pk: Long
- version: Long
- lastModified: Instant
- originNodeId: String
- name: String
- city: String
- country: String
- timezone: String
- imageUrl: String
- operationalHours: String
- contactInformation: String

        --
        + updateDetails(hours, contact)
        + updateImage(url)
        + updateStatus(status)
        + applyReplicationData(...)
        + applyReplicationMetadata(time, node)
    }
    class IATACode <<Value Object>> {
- code: String
    }
    enum AirportType <<Enumeration>> {
        INTERNATIONAL, REGIONAL, DOMESTIC
    }
    enum AirportStatus <<Enumeration>> {
        OPERATIONAL, CLOSED, UNDER_MAINTENANCE
    }
    class Coordinates <<Value Object>> {
- latitude: Double
- longitude: Double
    }
    class Runway <<Entity>> {
- name: String
- length: Double
- orientation: String
    }
    class Facility <<Value Object>> {
- type: String
- description: String
    }

    Airport "1" *-- "1" IATACode : identified by >
    Airport "1" *-- "1" Coordinates : located at >
    Airport "1" --> "1" AirportStatus : has >
    Airport "1" --> "1" AirportType : is of type >
    Airport "1" *-- "*" Runway : contains >
    Airport "1" *-- "*" Facility : has >
}

package "Route Aggregate" {
    class Route <<Entity>> <<Root>> {
- pk: Long
- version: Long
- lastModified: Instant
- originNodeId: String
- estimatedFlightTime: Integer
- minimumRange: Double
- minimumCapacity: Integer

        --
        + deactivate()
        + updateParameters(time, range, capacity)
        + applyReplicationData(...)
        + applyReplicationMetadata(time, node)
    }
    class RouteId <<Value Object>> {
- id: String
    }
    enum RouteStatus <<Enumeration>> {
        ACTIVE, INACTIVE
    }

    Route "1" *-- "1" RouteId : identified by >
    Route "1" --> "1" RouteStatus : has >
    Route "*" --> "1" Airport : origin (by ID) >
    Route "*" --> "1" Airport : destination (by ID) >
}

package "Route History" {
    class RouteHistory <<Entity>> {
- pk: Long
- routeId: String
- action: String
- startDate: LocalDateTime
- endDate: LocalDateTime

        --
        + closeHistory(endDate)
    }
    Route ..> RouteHistory : tracks history
    note bottom of RouteHistory
      startDate / endDate use the EVENT time (lastModified, UTC),
      identical on every instance; endDate is never before startDate
      (protection against out-of-order events).
    end note
}

package "Messaging Infrastructure (outbox + inbox)" {
    class ReplicationTask <<Outbox>> {
- id: Long
- peerUrl: String
- httpMethod: String
- path: String
- payload: String
- attempts: int
- nextAttemptAt: Instant
- createdAt: Instant
- originalUser: String
- lastModified: Instant
- originNodeId: String
- eventId: String (UUID)

        --
        + markDone()
        + fail(nextInstant)
    }

    enum Status <<Enumeration>> {
        PENDING, DONE, FAILED
    }
    ReplicationTask "1" --> "1" Status

    class ProcessedEvent <<Inbox>> {
- id: Long
- consumer: String
- eventId: String
- eventType: String
- processedAt: Instant
    }
    note bottom of ProcessedEvent
      Idempotent consumer: unique (consumer, eventId),
      eventId = UUID from the outbox task (= AMQP messageId).
      Saved in the same transaction as the event's effect.
    end note
    note bottom of ReplicationTask
      Transactional outbox: saved in the SAME transaction as the aggregate.
      AMQP mode: one task per event (peerUrl = "amqp://broker");
      HTTP mode (Entrega 1): one task per peer.
      Event type derived from method + path (ReplicationEventType).
    end note
}

package "CQRS Read Model (query side)" {
    class AirportReadModel <<Read Model>> {
- iataCode: String  {id}
- name: String
- city: String
- country: String
- status: String
- lastModified: Instant
- originNodeId: String
- viewJson: String
    }
    class RouteReadModel <<Read Model>> {
- routeId: String  {id}
- originIata: String
- destinationIata: String
- status: String
- minimumCapacity: Integer
- minimumRange: Double
- estimatedFlightTime: Integer
- originLatitude / originLongitude: Double
- destinationLatitude / destinationLongitude: Double
- lastModified: Instant
- originNodeId: String
    }
    note bottom of RouteReadModel
      Flat, denormalised tables (airport_read_model, route_read_model)
      written only by AirportProjector / RouteProjector, in the same
      transaction as the command. Coordinates are copied into the route
      row so GeoJSON, statistics and the BFS need no joins.
      Rebuilt from the write model at startup (ReadModelRebuilder).
    end note
}

note as Schema
  All tables are created by Flyway migrations
  (V1__airports_routes_schema.sql, V2__replication_task_event_id.sql);
  Hibernate only maps them (ddl-auto=none).
end note

Airport ..> AirportReadModel : projected to >
Route ..> RouteReadModel : projected to >

@enduml