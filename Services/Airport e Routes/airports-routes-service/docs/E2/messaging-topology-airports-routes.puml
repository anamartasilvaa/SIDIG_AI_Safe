@startuml messaging-topology-airports-routes
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
}
left to right direction
title Airports & Routes - Topologia AMQP (cluster RabbitMQ, fanout, filas quorum)

package "Quem publica (outbox)" {
  rectangle "airports-routes-1\nAmqpReplicationPublisher\n(de 2 em 2 s)" as pub1 #DDEBFF
  rectangle "airports-routes-2\nAmqpReplicationPublisher\n(de 2 em 2 s)" as pub2 #DDEBFF
}

package "Cluster RabbitMQ (3 nós, AMQPS 5671)" {
  collections "airports.events\n<<exchange fanout>>" as ex #FFF4D6

  queue "airports.events.airports-routes-1\n<<quorum>>\nTTL 1 h, máx. 10000" as q1
  queue "airports.events.airports-routes-2\n<<quorum>>\nTTL 1 h, máx. 10000" as q2
  queue "airports.events.airports-routes-1.dlq" as dlq1 #FFE0E0
  queue "airports.events.airports-routes-2.dlq" as dlq2 #FFE0E0

  queue "fo.routes.flight-operations-1\n(criada pelo FO)" as qf1 #EEEEEE
  queue "fo.routes.flight-operations-2\n(criada pelo FO)" as qf2 #EEEEEE
}

package "Quem consome" {
  rectangle "airports-routes-1\nReplicationEventConsumer" as c1 #DDEBFF
  rectangle "airports-routes-2\nReplicationEventConsumer" as c2 #DDEBFF
  rectangle "flight-operations-1 / -2\ncópia local das rotas" as cf #EEEEEE
}

pub1 --> ex : AIRPORT_* / ROUTE_*
pub2 --> ex

ex --> q1
ex --> q2
ex --> qf1
ex --> qf2

q1 --> c1
q2 --> c2
qf1 --> cf
qf2 --> cf

q1 ..> dlq1 : falhou 3 vezes,\nexpirou ou fila cheia
q2 ..> dlq2

note bottom of ex
  Fanout = cópia para TODAS as filas ligadas.
  Cada evento leva um eventId (UUID) único.
  A outbox só marca DONE quando o broker confirma.
end note

note bottom of q1
  Uma fila por instância: todas recebem tudo.
  Instância em baixo? A fila guarda os eventos (até 1 h).
  Ao consumir: ignora os seus, salta repetidos (inbox),
  aplica o resto com last-writer-wins.
end note
@enduml
