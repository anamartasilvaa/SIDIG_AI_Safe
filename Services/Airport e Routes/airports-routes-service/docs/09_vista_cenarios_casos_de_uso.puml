@startuml 09_vista_cenarios_casos_de_uso
title Vista de Cenários - User stories por perfil
left to right direction
actor "ATCC" as atcc
actor "Backoffice Operator" as bo
actor "Admin" as admin
bo -|> atcc
admin -|> bo

rectangle "Airports & Routes Service" {
  package "Aeroportos" {
    usecase "US106 Registar aeroporto" as u106
    usecase "US107 Ver aeroporto por IATA" as u107
    usecase "US108 Pesquisar aeroportos" as u108
    usecase "US109 Atualizar estado" as u109
    usecase "US207 Imagem e instalações" as u207
    usecase "US208 Horários e contacto" as u208
    usecase "US211 Agrupar por região/país" as u211
    usecase "US225 Importar CSV" as u225
  }
  package "Rotas" {
    usecase "US110 Criar rota" as u110
    usecase "US111 Histórico da rota" as u111
    usecase "US112 Atualizar/desativar rota" as u112
    usecase "US113/US114 Ver e pesquisar rotas" as u113
    usecase "US209 Rotas de/para aeroporto" as u209
    usecase "US210 Aeroportos mais movimentados" as u210
    usecase "US214 Rotas ativas ordenadas" as u214
    usecase "US215 Distância total da rede" as u215
    usecase "US216 Rotas alternativas" as u216
    usecase "US228 Exportar GeoJSON" as u228
  }
}
atcc --> u107
atcc --> u108
atcc --> u211
atcc --> u110
atcc --> u111
atcc --> u112
atcc --> u113
atcc --> u209
atcc --> u210
atcc --> u214
atcc --> u215
atcc --> u216
atcc --> u228
bo --> u106
bo --> u109
bo --> u207
bo --> u208
bo --> u225
note bottom
  Aeroportos: ATCC só lê (GET); POST/PATCH só Backoffice e Admin.
  Rotas: ATCC, Backoffice e Admin leem, criam e alteram.
  Fonte: SecurityConfig.
end note
@enduml
