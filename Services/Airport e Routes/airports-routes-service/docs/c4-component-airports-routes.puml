@startuml c4-component-airports-routes
!include <C4/C4_Component>
LAYOUT_TOP_DOWN()

title Airports & Routes Service - C4 Level 3 (Components)

Person(client, "AISafe User", "ATCC, Backoffice, Admin")
Container_Ext(gateway, "API Gateway", "NGINX, HTTPS :8443", "Routes in round-robin")
Container_Ext(keycloak, "Keycloak", "aisafe realm", "Issues RS256 JWT")
Container_Ext(peers, "Airports & Routes Replicas", "Spring Boot", "8091-8093 (local). Validates JWT.")
Container_Ext(fo, "Flight Operations Service", "Spring Boot", "Queries Routes and Airports to validate scheduling")

ContainerDb(db, "Airports Routes DB", "In-memory H2", "One DB per replica")

Container_Boundary(ar, "Airports & Routes Service (one replica)") {
    Component(jwt, "JwtAuthenticationFilter + Decoders", "OncePerRequestFilter", "Validates JWT RS256/HS256.")
    Component(correlation, "CorrelationIdFilter", "OncePerRequestFilter", "MDC tracking across requests.")
    Component(security, "SecurityConfig", "Spring Security", "RBAC (ROLE_ADMIN, ROLE_ATCC, ROLE_PEER).")
    
    Component(airportCtrl, "AirportController", "@RestController /api/airports", "Endpoints for Airports. Checks X-P2P-Sync.")
    Component(routeCtrl, "RouteController", "@RestController /api/routes", "Endpoints for Routes.")
    Component(adminCtrl, "AdminReplicationController", "@RestController /api/admin", "Reads replication tasks.")
    
    Component(airportSvc, "AirportService", "@Service", "CRUD, Forwarding, Grouping.")
    Component(routeSvc, "RouteService", "@Service", "CRUD, History, Stats, Forwarding.")
    Component(fastest, "FastestRouteStrategy", "@Component", "BFS graph search for alternative routes (US216).")
    
    Component(outbox, "ReplicationOutbox", "@Service", "Enqueues payloads to ReplicationTask table.")
    Component(scheduler, "ReplicationTaskScheduler", "@Scheduled", "Background worker. Retries failed tasks every 5s.")
    
    Component(domain, "Domain Entities", "JPA Aggregates", "Airport, Route, RouteHistory, ReplicationTask.")
    
    Component(http, "RestTemplateConfig + Interceptors", "RestTemplate", "PeerResilienceInterceptor (Circuit Breaker), JwtClientHttpRequestInterceptor.")
    
    Component(repo, "Spring Data JPA Repositories", "Repositories", "AirportRepository, RouteRepository, etc.")
}

Rel(client, gateway, "Requests with Bearer JWT", "HTTPS")
Rel(gateway, jwt, "Forwards request", "HTTPS")
Rel(jwt, keycloak, "Fetches public key", "JWKS")
Rel(jwt, correlation, "Passes")
Rel(correlation, security, "Passes")
Rel(security, airportCtrl, "If authorized")
Rel(security, routeCtrl, "If authorized")

Rel(airportCtrl, airportSvc, "Uses")
Rel(routeCtrl, routeSvc, "Uses")
Rel(routeSvc, fastest, "Uses for US216")

Rel(airportSvc, outbox, "Enqueues writes")
Rel(routeSvc, outbox, "Enqueues writes")
Rel(outbox, repo, "Saves task to DB")

Rel(scheduler, repo, "Fetches PENDING tasks")
Rel(scheduler, http, "Executes async replication (X-P2P-Sync)")

Rel(airportSvc, http, "Synchronous forwarding (X-P2P-Hops)")
Rel(routeSvc, http, "Synchronous forwarding (X-P2P-Hops)")
Rel(fastest, http, "Fetches peer routes for BFS")

Rel(http, peers, "Calls peer APIs", "HTTPS + JWT / X-P2P-Sync")
Rel(fo, gateway, "Queries Route/Airport info")

Rel(repo, db, "Reads/Writes", "JDBC")

@enduml