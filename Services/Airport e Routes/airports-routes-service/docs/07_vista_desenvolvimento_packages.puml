@startuml 07_vista_desenvolvimento_packages
title Vista de Desenvolvimento - Packages (pt.isep.psoft.aisafe.airports_routes_service)
skinparam componentStyle rectangle

package "api" {
  [AirportController]
  [RouteController]
}
package "application" {
  [AirportService]
  [RouteService]
  [RouteSearchStrategy]
  [FastestRouteStrategy]
  [DTO (records)]
}
package "domain" {
  [Airport]
  [Route]
  [RouteHistory]
  [Value Objects]
}
package "repositories" {
  [AirportRepository]
  [RouteRepository]
  [RouteHistoryRepository]
}
package "security" {
  [JwtAuthenticationFilter]
}
package "config" {
  [SecurityConfig]
  [RestTemplateConfig]
}
package "bootstrapper" {
  [AirportBootstrapper]
  [RouteBootstrapper]
}

[AirportController] --> [AirportService]
[RouteController] --> [RouteService]
[AirportController] ..> [DTO (records)]
[RouteController] ..> [DTO (records)]
[AirportService] --> [AirportRepository]
[RouteService] --> [RouteRepository]
[RouteService] --> [RouteHistoryRepository]
[RouteService] --> [RouteSearchStrategy]
[FastestRouteStrategy] ..|> [RouteSearchStrategy]
[AirportRepository] --> [Airport]
[RouteRepository] --> [Route]
[RouteHistoryRepository] --> [RouteHistory]
[SecurityConfig] --> [JwtAuthenticationFilter]
[AirportService] ..> [RestTemplateConfig] : RestTemplate (P2P)
[RouteService] ..> [RestTemplateConfig] : RestTemplate (P2P)
[AirportBootstrapper] --> [AirportService]
[RouteBootstrapper] --> [RouteService]
@enduml
