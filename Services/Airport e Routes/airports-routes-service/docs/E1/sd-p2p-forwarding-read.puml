@startuml sd-p2p-forwarding-read
skinparam style strictuml
autonumber
title SD - Distributed Read with P2P Forwarding and Hops (US107)

actor "Client / Gateway" as User
box "A&R Replica 1 (Port 8091)" #F4F7FF
participant "AirportController" as Ctrl
participant "AirportService" as Svc
participant "AirportRepository" as Repo
participant "RestTemplate" as Http
end box
participant "A&R Replica 2 (Peer)" as Peer2
participant "A&R Replica 3 (Offline)" as Peer3

User -> Ctrl : GET /api/airports/JFK
activate Ctrl
Ctrl -> Svc : getAirportByIataCode("JFK", hops=0)
activate Svc

Svc -> Repo : findByIataCodeString("JFK")
Repo --> Svc : Optional.empty()

loop Query Peers sequentially/iteratively
    Svc -> Http : GET /api/airports/JFK (Header: X-P2P-Hops = 1)
    activate Http
    Http -> Peer2 : GET /api/airports/JFK
    Peer2 --> Http : 404 Not Found
    Http --> Svc : HttpClientErrorException.NotFound
    deactivate Http
    Svc -> Svc : ignores 404, tries next peer

    Svc -> Http : GET /api/airports/JFK (Header: X-P2P-Hops = 1)
    activate Http
    Http -> Peer3 : GET /api/airports/JFK
    Peer3 --> Http : Connection Refused (Timeout)
    Http --> Svc : RestClientException
    deactivate Http
    Svc -> Svc : peerFailure = true
end

alt Peer found the data
else No peer found it, but one failed
    Svc -> Svc : throw ResponseStatusException(503)

    Svc --> Ctrl : 503 Service Unavailable
end

Ctrl --> User : 503 Service Unavailable
deactivate Svc
deactivate Ctrl
@enduml