@startuml messaging-topology-aircraft-maintenance
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam rectangle {
  RoundCorner 8
}
left to right direction
title Aircraft e Maintenance - Topologia AMQP (cluster RabbitMQ, filas quorum)

package "Quem publica (após o commit)" {
  rectangle "aircraft-1 / aircraft-2\nAircraftEventPublisher" as pa #DDEBFF
  rectangle "maintenance-1 / maintenance-2\nMaintenanceEventPublisher" as pm #E6F7E6
  rectangle "flight-operations-1 / -2\n(outbox do FO)" as pf #EEEEEE
}

package "Cluster RabbitMQ (3 nós, AMQPS 5671)" {
  collections "aircraft.events\n<<exchange topic>>" as exA #FFF4D6
  collections "maintenance.events\n<<exchange fanout>>" as exM #FFF4D6
  collections "flights.events\n<<exchange topic>>" as exF #FFF4D6

  queue "aircraft.maintenance\n<<quorum, partilhada>>\nmáx. 5 entregas" as qam
  queue "aircraft.flights.<inst>\n<<quorum>>\nmáx. 5 entregas" as qaf
  queue "maintenance.aircraft.<inst>\n<<quorum>>\nmáx. 5 entregas" as qma
  queue "fo.aircraft.<inst>\n(criada pelo FO)" as qfa #EEEEEE

  collections "aircraft.dlx (fanout)" as dlxA #FFE0E0
  queue "aircraft.dead-letter" as dlqA #FFE0E0
  collections "maintenance.dlx (fanout)" as dlxM #FFE0E0
  queue "maintenance.dead-letter" as dlqM #FFE0E0
}

rectangle "Aircraft\nFlightEventListener" as caf #DDEBFF
rectangle "Maintenance\nAircraftEventListener\n(aircraft_reference)" as cma #E6F7E6
rectangle "Flight Operations\ncópia aircraft_ref" as cfa #EEEEEE
rectangle "Aircraft\nMaintenanceEventListener" as cam #DDEBFF

pa --> exA : AircraftRegistered\nAircraftStatusChanged\nAircraftUpdated
pm --> exM : MaintenanceStarted /\nMaintenanceCompleted
pf --> exF : Flight*\n(flight.*)

exM --> qam
exF --> qaf : flight.#
exA --> qma : aircraft.#
exA --> qfa : aircraft.#

qam --> cam
qaf --> caf
qma --> cma
qfa --> cfa

qam ..> dlxA
qaf ..> dlxA
dlxA --> dlqA
qma ..> dlxM
dlxM --> dlqM

legend bottom
  As filas maintenance.aircraft.N e aircraft.flights.N são por instância. A fila aircraft.maintenance é partilhada pelas duas réplicas.
  As filas são declaradas pelo próprio serviço no arranque (as fo.* são criadas pelo FO).
  Ao consumir: salta repetidos (processed_event), aplica o resto na mesma transação e só depois confirma a mensagem.
  Qualquer erro ao processar -> a mensagem vai para a dead-letter do serviço (sem nova tentativa).
endlegend
@enduml
